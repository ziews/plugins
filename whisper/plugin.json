{
  "name": "whisper",
  "version": "0.1.0",
  "type": "ai",
  "description": "Speech-to-text via whisper.cpp",
  "homepage": "https://github.com/ggerganov/whisper.cpp",
  "status": "planned",
  "requires": {
    "ziew": ">=0.3.0"
  },
  "features": [
    "Audio transcription via ziew.ai.transcribe()",
    "Multiple model sizes (tiny to large)",
    "Real-time streaming transcription"
  ],
  "models": {
    "storage": "~/.ziew/models/",
    "recommended": [
      "whisper-small.bin",
      "whisper-base.bin"
    ]
  }
}
